{
  "name": "coursewright",
  "version": "1.2.0",
  "private": true,
  "description": "Write your course in markdown; publish it as a website, PDF or DOCX handouts, or straight into Canvas LMS",
  "license": "MIT",
  "author": "Lars De Richter",
  "repository": {
    "type": "git",
    "url": "https://github.com/lars-derichter/coursewright"
  },
  "homepage": "https://github.com/lars-derichter/coursewright#readme",
  "bugs": {
    "url": "https://github.com/lars-derichter/coursewright/issues"
  },
  "bin": {
    "course": "./cli/index.js"
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "course:setup": "node cli/index.js setup",
    "canvas:init": "node cli/index.js init",
    "canvas:sync": "node cli/index.js sync",
    "canvas:push": "node cli/index.js push",
    "canvas:pull": "node cli/index.js pull",
    "canvas:status": "node cli/index.js status",
    "module:new": "node cli/index.js new-module",
    "module:move": "node cli/index.js move-module",
    "module:rename": "node cli/index.js rename-module",
    "module:delete": "node cli/index.js delete-module",
    "item:new": "node cli/index.js new-item",
    "item:move": "node cli/index.js move-item",
    "item:movetomodule": "node cli/index.js movetomodule-item",
    "item:rename": "node cli/index.js rename-item",
    "item:delete": "node cli/index.js delete-item",
    "vscode:package": "cd .vscode/extensions/course-manager && npx @vscode/vsce package -o coursewright.vsix",
    "pretest": "node scripts/check-test-glob.js \"test/**/*.test.js\"",
    "test": "node --test \"test/**/*.test.js\"",
    "test:template": "node --test \"test/template/**/*.check.js\"",
    "test:vscode": "npm run vscode:package && node test/vscode/host/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:links": "lychee README.md AGENTS.md CHANGELOG.md \"docs/**/*.md\" \"course/**/*.md\" \"context/*.md\" \".agents/skills/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:install": "npm run vscode:package && code --install-extension .vscode/extensions/course-manager/coursewright.vsix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.9",
    "marked-alert": "^2.1.2",
    "prettier": "^3.9.6",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@eslint/js": "^10.0.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
