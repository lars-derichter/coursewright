{
  "name": "coursewright",
  "displayName": "Coursewright",
  "description": "VS Code sidebar and palette commands for the Coursewright CLI",
  "version": "1.3.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lars-derichter/coursewright"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Course Manager",
      "properties": {
        "courseManager.previewPort": {
          "type": "integer",
          "default": 3000,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port the preview runs on. `Course: Preview` starts the Docusaurus dev server with `npm start -- --port <port>` and opens this port in the browser, so set it to match when something else on this machine already uses 3000."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "course-manager",
          "title": "Course Manager",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "course-manager": [
        {
          "id": "courseTree",
          "name": "Course Modules"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "courseTree",
        "contents": "No folder is open, so there is no course to show.\nUse File > Open Folder to open your course project; the modules in its course/ folder appear here.",
        "when": "workbenchState == empty"
      },
      {
        "view": "courseTree",
        "contents": "No course modules found.\nRun the first-run wizard to set up the course name, language and look, then add your first module.\n[Course: Setup (First-Run Wizard)](command:course.setup)\nThe [tutorial module](https://github.com/lars-derichter/coursewright/tree/main/course/01-getting-started) walks through the whole workflow. Read it live at [coursewright.md](https://coursewright.md/).",
        "when": "workbenchState != empty"
      }
    ],
    "commands": [
      {
        "command": "course.setup",
        "title": "Course: Setup (First-Run Wizard)"
      },
      {
        "command": "course.init",
        "title": "Course: Init (Canvas Setup)"
      },
      {
        "command": "course.sync",
        "title": "Course: Sync with Canvas"
      },
      {
        "command": "course.syncDryRun",
        "title": "Course: Sync with Canvas (Dry Run)"
      },
      {
        "command": "course.push",
        "title": "Course: Push to Canvas"
      },
      {
        "command": "course.pushDryRun",
        "title": "Course: Push to Canvas (Dry Run)"
      },
      {
        "command": "course.pushModule",
        "title": "Course: Push Module to Canvas..."
      },
      {
        "command": "course.pull",
        "title": "Course: Pull from Canvas"
      },
      {
        "command": "course.pullDryRun",
        "title": "Course: Pull from Canvas (Dry Run)"
      },
      {
        "command": "course.status",
        "title": "Course: Status"
      },
      {
        "command": "course.newModule",
        "title": "Course: New Module",
        "icon": "$(new-folder)"
      },
      {
        "command": "course.moveModule",
        "title": "Course: Move Module"
      },
      {
        "command": "course.renameModule",
        "title": "Course: Rename Module"
      },
      {
        "command": "course.deleteModule",
        "title": "Course: Delete Module"
      },
      {
        "command": "course.newItem",
        "title": "Course: New Item"
      },
      {
        "command": "course.moveItem",
        "title": "Course: Move Item"
      },
      {
        "command": "course.moveItemToModule",
        "title": "Course: Move Item to Module"
      },
      {
        "command": "course.renameItem",
        "title": "Course: Rename Item"
      },
      {
        "command": "course.deleteItem",
        "title": "Course: Delete Item"
      },
      {
        "command": "course.mergeSetSource",
        "title": "Merge: Set as Source"
      },
      {
        "command": "course.mergeWithSource",
        "title": "Merge with Source"
      },
      {
        "command": "course.mergeItems",
        "title": "Course: Merge Items"
      },
      {
        "command": "course.splitItem",
        "title": "Course: Split Item at Cursor"
      },
      {
        "command": "course.validate",
        "title": "Course: Validate"
      },
      {
        "command": "course.check",
        "title": "Course: Check"
      },
      {
        "command": "course.search",
        "title": "Course: Search...",
        "icon": "$(search)"
      },
      {
        "command": "course.preview",
        "title": "Course: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "course.refreshTree",
        "title": "Course: Refresh Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "course.openInCanvas",
        "title": "Open in Canvas",
        "icon": "$(link-external)"
      },
      {
        "command": "course.pushItem",
        "title": "Push This Module to Canvas",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "course.syncItem",
        "title": "Sync This Module with Canvas"
      },
      {
        "command": "course.pullItem",
        "title": "Pull This Module from Canvas"
      },
      {
        "command": "course.statusItem",
        "title": "Status of This Module"
      },
      {
        "command": "course.exportItem",
        "title": "Course: Export Item to PDF/DOCX..."
      },
      {
        "command": "course.exportModule",
        "title": "Course: Export Module to PDF/DOCX..."
      },
      {
        "command": "course.exportCourse",
        "title": "Course: Export Course to PDF/DOCX..."
      },
      {
        "command": "course.exportCourseToc",
        "title": "Course: Export via TOC..."
      },
      {
        "command": "course.buildGlossary",
        "title": "Course: Build Glossary"
      },
      {
        "command": "course.resetSyncState",
        "title": "Course: Reset Sync State (Destructive)"
      },
      {
        "command": "course.resetCanvas",
        "title": "Course: Reset Canvas (Deletes ALL Canvas Content)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "course.mergeSetSource",
          "when": "false"
        },
        {
          "command": "course.mergeWithSource",
          "when": "false"
        },
        {
          "command": "course.openInCanvas",
          "when": "false"
        },
        {
          "command": "course.pushItem",
          "when": "false"
        },
        {
          "command": "course.syncItem",
          "when": "false"
        },
        {
          "command": "course.pullItem",
          "when": "false"
        },
        {
          "command": "course.statusItem",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "course.splitItem",
          "when": "resourceExtname == .md && resourcePath =~ /[\\\\/]course[\\\\/]/",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "course.newModule",
          "when": "view == courseTree",
          "group": "navigation"
        },
        {
          "command": "course.search",
          "when": "view == courseTree",
          "group": "navigation"
        },
        {
          "command": "course.preview",
          "when": "view == courseTree",
          "group": "navigation"
        },
        {
          "command": "course.refreshTree",
          "when": "view == courseTree",
          "group": "navigation"
        },
        {
          "command": "course.preview",
          "when": "view == courseTree"
        },
        {
          "command": "course.sync",
          "when": "view == courseTree"
        },
        {
          "command": "course.push",
          "when": "view == courseTree"
        },
        {
          "command": "course.pull",
          "when": "view == courseTree"
        },
        {
          "command": "course.status",
          "when": "view == courseTree"
        },
        {
          "command": "course.validate",
          "when": "view == courseTree"
        },
        {
          "command": "course.exportCourse",
          "when": "view == courseTree"
        },
        {
          "command": "course.exportCourseToc",
          "when": "view == courseTree && course.tocReady"
        }
      ],
      "view/item/context": [
        {
          "command": "course.pushItem",
          "when": "view == courseTree && viewItem == module",
          "group": "inline"
        },
        {
          "command": "course.openInCanvas",
          "when": "view == courseTree && viewItem =~ /^(module|page|assignment|discussion|quiz|external_url|external_tool|file)$/",
          "group": "inline"
        },
        {
          "command": "course.newItem",
          "when": "view == courseTree && viewItem =~ /^(module|subheader)$/",
          "group": "0_new"
        },
        {
          "command": "course.newModule",
          "when": "view == courseTree && viewItem == module",
          "group": "0_new"
        },
        {
          "command": "course.renameItem",
          "when": "view == courseTree && viewItem =~ /^(page|assignment|discussion|external_url|file|subheader)$/",
          "group": "1_edit"
        },
        {
          "command": "course.moveItem",
          "when": "view == courseTree && viewItem =~ /^(page|assignment|discussion|external_url|file|subheader)$/",
          "group": "1_edit"
        },
        {
          "command": "course.moveItemToModule",
          "when": "view == courseTree && viewItem =~ /^(page|assignment|discussion|external_url|file|subheader)$/",
          "group": "1_edit"
        },
        {
          "command": "course.renameModule",
          "when": "view == courseTree && viewItem == module",
          "group": "1_edit"
        },
        {
          "command": "course.moveModule",
          "when": "view == courseTree && viewItem == module",
          "group": "1_edit"
        },
        {
          "command": "course.mergeSetSource",
          "when": "view == courseTree && viewItem =~ /^(page|assignment)$/",
          "group": "1_edit"
        },
        {
          "command": "course.mergeWithSource",
          "when": "view == courseTree && viewItem =~ /^(page|assignment)$/ && course.mergeSourceSet",
          "group": "1_edit"
        },
        {
          "command": "course.deleteItem",
          "when": "view == courseTree && viewItem =~ /^(page|assignment|discussion|external_url|file|subheader)$/",
          "group": "2_danger"
        },
        {
          "command": "course.deleteModule",
          "when": "view == courseTree && viewItem == module",
          "group": "2_danger"
        },
        {
          "command": "course.exportItem",
          "when": "view == courseTree && viewItem =~ /^(page|assignment|discussion|external_url|file)$/",
          "group": "3_export"
        },
        {
          "command": "course.exportModule",
          "when": "view == courseTree && viewItem == module",
          "group": "3_export"
        },
        {
          "command": "course.syncItem",
          "when": "view == courseTree && viewItem == module",
          "group": "4_canvas@1"
        },
        {
          "command": "course.pushItem",
          "when": "view == courseTree && viewItem == module",
          "group": "4_canvas@2"
        },
        {
          "command": "course.pullItem",
          "when": "view == courseTree && viewItem == module",
          "group": "4_canvas@3"
        },
        {
          "command": "course.statusItem",
          "when": "view == courseTree && viewItem == module",
          "group": "4_canvas@4"
        }
      ]
    }
  }
}
