# Prettier already skips node_modules and everything in .gitignore, so build/,
# .docusaurus/ and exports/ need no entry here.

# npm rewrites this on every install; if its formatting ever diverges from
# Prettier's, format:check fails on a lock file nobody edited by hand
package-lock.json

# Study packs are condensed by /study-pack-build from a raw export and checked
# against it; their recipes hold `- path  # title` lines, and the raw exports
# come from `npx course export -f md`. Prettier rewrapping any of the three
# would be undone by the next build and would muddy the check
course/**/_files/*.md
sources/study-packs/*.toc.md
sources/study-packs/raw/

# `lib/sync/state.js` writes this file, and its JSON.stringify output is not
# what Prettier would produce: a single-element array stays expanded. Without
# this entry every sync leaves the repository failing format:check on a file
# nobody edited by hand, and running Prettier over it is undone by the next
# sync anyway
.canvas-sync.json

# The style sample is pandoc markdown with fenced divs (`::: {.alert .note}`),
# which Prettier reads as plain paragraphs: with proseWrap it joins each fence
# onto the line below and pandoc then prints the block as literal text
export-styles/sample.md
